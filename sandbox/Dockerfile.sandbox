# CTF challenge solver sandbox image.
# Build once: docker build -f Dockerfile.sandbox -t ctf-sandbox .

FROM eclipse-temurin:25-jdk-jammy AS java25

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TERM=xterm

# ── System packages ───────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y \
    # Networking
    netcat-openbsd curl wget nmap socat dnsutils whois tcpdump tshark \
    # Binary analysis
    binutils file xxd bsdmainutils binwalk \
    gdb gdb-multiarch ltrace strace qemu-user-static qemu-system-x86 patchelf nasm gcc-multilib libc6-dbg \
    # Forensics / steg / image analysis
    exiftool steghide \
    pngcheck imagemagick \
    # Filesystem forensics
    xfsprogs sleuthkit foremost dcfldd testdisk yara p7zip-full sqlite3 \
    # Audio / media
    ffmpeg sox \
    # OCR
    tesseract-ocr tesseract-ocr-eng \
    # Crypto / encoding
    openssl libssl-dev \
    # Build tools
    gcc g++ make cmake cpio busybox-static musl-tools \
    # Python (system base)
    python3 python3-pip python3-dev \
    # Ruby (for zsteg)
    ruby ruby-dev \
    # Java (for Ghidra headless if mounted)
    default-jre-headless apktool \
    # Misc
    git jq zip unzip ca-certificates ncurses-term john hashcat \
    # Math libs (required by flatter, cado-nfs, fpylll)
    libgmp-dev libmpfr-dev libfplll-dev libeigen3-dev \
    # z3 solver system lib
    libz3-dev \
    # SageMath (Ubuntu 22.04 ships 9.x, works on aarch64 and amd64)
    sagemath \
    # CADO-NFS build deps
    libhwloc-dev libbz2-dev \
    && rm -rf /var/lib/apt/lists/*

# ── Podman (nested containers — run challenge Docker images inside sandbox) ───
# Ubuntu 22.04 needs the kubic repo for podman
RUN apt-get update && apt-get install -y curl gnupg2 \
    && . /etc/os-release \
    && echo "deb https://download.opensuse.org/repositories/devel:/kubic:/libcontainers:/stable/xUbuntu_${VERSION_ID}/ /" \
       > /etc/apt/sources.list.d/devel:kubic:libcontainers:stable.list \
    && curl -fsSL "https://download.opensuse.org/repositories/devel:/kubic:/libcontainers:/stable/xUbuntu_${VERSION_ID}/Release.key" \
       | gpg --dearmor -o /etc/apt/trusted.gpg.d/kubic.gpg \
    && apt-get update && apt-get install -y podman buildah fuse-overlayfs slirp4netns \
    && rm -rf /var/lib/apt/lists/* \
    || echo "Podman install failed (non-fatal) — nested containers will not be available"

# ── radare2 ───────────────────────────────────────────────────────────────────
RUN git clone --depth=1 https://github.com/radareorg/radare2 /tmp/r2 \
    && cd /tmp/r2 && bash sys/install.sh --install \
    && ldconfig \
    && r2 -v \
    && rm -rf /tmp/r2

# ── flatter (fast lattice reduction — Keegan Ryan's fork) ────────────────────
RUN git clone --depth=1 https://github.com/keeganryan/flatter /tmp/flatter \
    && cmake -S /tmp/flatter -B /tmp/flatter/build \
        -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /tmp/flatter/build -j$(nproc) \
    && cmake --install /tmp/flatter/build \
    && ldconfig \
    && rm -rf /tmp/flatter

# ── uv (fast Python package manager) ─────────────────────────────────────────
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.cargo/bin:/root/.local/bin:$PATH"

# ── zsteg ─────────────────────────────────────────────────────────────────────
RUN gem install zsteg one_gadget

# ── stegseek (build from source — pre-built .deb is amd64 only) ──────────────
RUN apt-get update && apt-get install -y libmhash-dev libmcrypt-dev libjpeg-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/* \
    && git clone --depth=1 https://github.com/RickdeJager/stegseek /tmp/stegseek \
    && cmake -S /tmp/stegseek -B /tmp/stegseek/build \
    && cmake --build /tmp/stegseek/build --target install \
    && rm -rf /tmp/stegseek

# ── Python CTF libraries (system python3) ────────────────────────────────────
RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel
RUN pip3 install --no-cache-dir \
    pwntools \
    pycryptodome \
    sympy \
    gmpy2 \
    requests \
    Pillow \
    z3-solver \
    pytesseract \
    scipy \
    numpy \
    angr \
    capstone \
    unicorn \
    ropgadget \
    tqdm \
    fpylll \
    flask \
    volatility3 \
    PyJWT \
    pyghidra \
    lief \
    ropper \
    scapy \
    pyelftools \
    keystone-engine \
    zstandard \
    networkx \
    websocket-client \
    playwright \
    beautifulsoup4 \
    lxml \
    androguard \
    web3 \
    eth-abi

# Real browser engine for JavaScript-heavy web and bot challenges.
RUN playwright install --with-deps chromium

# ── PyTorch (CPU-only) + Keras ────────────────────────────────────────────────
RUN pip3 install --no-cache-dir --ignore-installed sympy \
    torch --index-url https://download.pytorch.org/whl/cpu \
    && pip3 install --no-cache-dir keras \
    && pip3 install --no-cache-dir --upgrade "numpy<2" "scipy<1.16" "ml-dtypes<0.6"

# ── RsaCtfTool (isolated because upstream pins old crypto/network libraries) ──
RUN git clone --depth=1 https://github.com/RsaCtfTool/RsaCtfTool /opt/RsaCtfTool \
    && uv venv /opt/rsactftool-venv \
    && uv pip install --python /opt/rsactftool-venv/bin/python /opt/RsaCtfTool \
    && ln -s /opt/rsactftool-venv/bin/RsaCtfTool /usr/local/bin/RsaCtfTool

# ── CADO-NFS (Number Field Sieve — large integer factoring + DLP) ─────────────
RUN git clone --depth=1 https://gitlab.inria.fr/cado-nfs/cado-nfs.git /opt/cado-nfs \
    && cd /opt/cado-nfs && make -j$(nproc)
RUN printf '#!/bin/bash\n\
BUILD_PARENT=/opt/cado-nfs/build\n\
H=$(hostname)\n\
if [ ! -d "$BUILD_PARENT/$H" ]; then\n\
  src=$(ls -d "$BUILD_PARENT"/* 2>/dev/null | head -1)\n\
  [ -n "$src" ] && ln -sf "$src" "$BUILD_PARENT/$H"\n\
fi\n\
exec python3 /opt/cado-nfs/cado-nfs.py "$@"\n' > /usr/local/bin/cado-nfs \
    && chmod +x /usr/local/bin/cado-nfs

# Ubuntu's bundled requests is too old for the urllib3 used by Web3 tooling.
RUN pip3 install --no-cache-dir --upgrade requests

# Curated CTF technique catalog. Pin the reviewed revision so solver behavior
# does not change between image rebuilds. Agents read category SKILL.md files;
# bundled installers/scripts are never run automatically.
ARG CTF_SKILLS_REF=36c72e53a96a035791821caff7440882ea0f5c57
RUN mkdir -p /challenge/skills \
    && git -C /challenge/skills init \
    && git -C /challenge/skills remote add origin https://github.com/ljagiello/ctf-skills.git \
    && git -C /challenge/skills fetch --depth=1 origin "$CTF_SKILLS_REF" \
    && git -C /challenge/skills checkout --detach FETCH_HEAD \
    && test -f /challenge/skills/ctf-pwn/SKILL.md \
    && test -f /challenge/skills/ctf-reverse/SKILL.md \
    && rm -rf /challenge/skills/.git \
    && chmod -R a-w /challenge/skills

# ── Android and native GUI/headless reverse engineering ──────────────────────
# Ghidra 12.1 requires a Java 25 JDK. Keep the contest base on Ubuntu 22.04 and
# copy a pinned Jammy JDK only after the heavyweight, stable CTF layers.
COPY --from=java25 /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="/opt/java/openjdk/bin:$PATH"

# The cross-platform JADX archive provides both jadx (CLI) and jadx-gui. Ghidra
# provides its GUI plus analyzeHeadless; automated solvers use the headless
# entry points, while a display-capable host can opt into the GUI binaries.
ARG JADX_VERSION=1.5.6
ARG JADX_SHA256=545ea2be9c242511bc145755cf4bda2485ade42966e096f8b4d3da2a230e8974
RUN wget -q "https://github.com/skylot/jadx/releases/download/v${JADX_VERSION}/jadx-${JADX_VERSION}.zip" -O /tmp/jadx.zip \
    && echo "${JADX_SHA256}  /tmp/jadx.zip" | sha256sum -c - \
    && mkdir -p /opt/jadx \
    && unzip -q /tmp/jadx.zip -d /opt/jadx \
    && ln -s /opt/jadx/bin/jadx /usr/local/bin/jadx \
    && ln -s /opt/jadx/bin/jadx-gui /usr/local/bin/jadx-gui \
    && rm /tmp/jadx.zip \
    && jadx --version

ARG GHIDRA_VERSION=12.1.3
ARG GHIDRA_BUILD_DATE=20260817
ARG GHIDRA_SHA256=93a5d11a9ad510622acaaf908c556a7b9b764d338e78a7567f3689bf5081fd54
RUN wget -q "https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_${GHIDRA_VERSION}_build/ghidra_${GHIDRA_VERSION}_PUBLIC_${GHIDRA_BUILD_DATE}.zip" -O /tmp/ghidra.zip \
    && echo "${GHIDRA_SHA256}  /tmp/ghidra.zip" | sha256sum -c - \
    && unzip -q /tmp/ghidra.zip -d /opt \
    && mv "/opt/ghidra_${GHIDRA_VERSION}_PUBLIC" /opt/ghidra \
    && ln -s /opt/ghidra/support/analyzeHeadless /usr/local/bin/analyzeHeadless \
    && ln -s /opt/ghidra/ghidraRun /usr/local/bin/ghidraRun \
    && rm /tmp/ghidra.zip \
    && test -x /opt/ghidra/support/analyzeHeadless
ENV GHIDRA_INSTALL_DIR=/opt/ghidra

# ── Tools reference ──────────────────────────────────────────────────────────
COPY sandbox/sandbox-tools.txt /tools.txt
COPY sandbox/capture_terminal.py /usr/local/bin/capture-terminal
RUN chmod 755 /usr/local/bin/capture-terminal

WORKDIR /challenge
