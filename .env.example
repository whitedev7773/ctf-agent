# CTFd (optional; leave empty for standalone mode or enter it in the dashboard)
CTFD_URL=
CTFD_TOKEN=

# API fallback keys (optional when using an authenticated Codex CLI session)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
# Explicit opt-in only: may create usage-based API charges after subscription quota exhaustion
ENABLE_API_FALLBACK=false

# Optional on Windows when Codex is not available through PATH
# CODEX_CLI_PATH=C:\Users\you\.vscode\extensions\openai.chatgpt-...\bin\windows-x86_64\codex.exe

# Contest runtime policy (desktop-safe defaults)
MAX_CONCURRENT_CHALLENGES=1
CONTAINER_MEMORY_LIMIT=4g
CONTAINER_CPU_LIMIT=2.0
WORKSPACE_ROOT=workspace
WRITEUP_GENERATION_TIMEOUT_SECONDS=1800
EXPERIENCE_ROOT=experience
LOGS_ROOT=logs
RESOURCE_SAMPLE_INTERVAL_SECONDS=2.0
SOLVER_TURN_TIMEOUT_SECONDS=1800
# Resume a turn after this many seconds without model/tool activity. 0 disables.
SOLVER_TURN_IDLE_TIMEOUT_SECONDS=300
SOLVER_MAX_RUNTIME_SECONDS=10800
# ANALYST waits this long for SCOUT; VERIFIER waits twice this value. 0 disables staging.
SOLVER_HANDOFF_WAIT_SECONDS=180
MAX_ATTEMPTS_PER_CHALLENGE=8
SOLVER_MAX_STEPS=300
# Cache-weighted effective budget. Cached input counts at 10% by default.
SOLVER_MAX_TOKENS=1500000
# Independent raw safety ceiling and per-turn compact/resume slice.
SOLVER_MAX_RAW_TOKENS=12000000
SOLVER_CACHED_TOKEN_WEIGHT=0.10
SOLVER_TURN_SLICE_TOKENS=1500000
# 0 disables the estimated-dollar limit (ChatGPT subscription cost is only estimated)
SOLVER_MAX_ESTIMATED_COST_USD=0
MAX_FLAG_SUBMISSIONS_PER_CHALLENGE=8
MAX_COMMAND_TIMEOUT_SECONDS=600

# SOL-high is the primary solver. It may create bounded Luna-low workers for
# narrow parallel tasks while continuing the main solve path itself.
DYNAMIC_DELEGATION_ENABLED=true
DELEGATE_MODEL_SPEC=codex/gpt-5.6-luna/low
DELEGATE_MAX_AGENTS=4
DELEGATE_MAX_CONCURRENT=2
DELEGATE_MAX_ATTEMPTS=4
DELEGATE_MAX_RUNTIME_SECONDS=1800
DELEGATE_TURN_TIMEOUT_SECONDS=600
DELEGATE_TURN_IDLE_TIMEOUT_SECONDS=180
DELEGATE_MAX_STEPS=96
DELEGATE_MAX_TOKENS=250000
DELEGATE_MAX_RAW_TOKENS=1200000
DELEGATE_TURN_SLICE_TOKENS=300000
# One reserved Luna worker may consolidate an interrupted delegate whose handoff
# is missing or unsafe. It cannot recursively create another postprocessor.
DELEGATE_POSTPROCESS_ON_BUDGET_STOP=true
DELEGATE_POSTPROCESS_MAX_AGENTS=1
DELEGATE_POSTPROCESS_MAX_ATTEMPTS=1
DELEGATE_POSTPROCESS_MAX_RUNTIME_SECONDS=600
DELEGATE_POSTPROCESS_TURN_TIMEOUT_SECONDS=300
DELEGATE_POSTPROCESS_TURN_IDLE_TIMEOUT_SECONDS=120
DELEGATE_POSTPROCESS_MAX_STEPS=40
DELEGATE_POSTPROCESS_MAX_TOKENS=80000
DELEGATE_POSTPROCESS_MAX_RAW_TOKENS=400000
DELEGATE_POSTPROCESS_TURN_SLICE_TOKENS=150000
